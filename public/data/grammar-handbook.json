    {
      "id": 100001,
      "word": "I",
      "meaning": "我",
      "pos": "pron. 主格",
      "category": "人称代词",
      "usage": "作主语，说明谁做某件事；无论在句中什么位置，I 都要大写。",
      "examples": [
        {
          "sentence": "I read books.",
          "translation": "我读书。",
          "exampleOrigin": "manual"
        }
      ],
      "sourceSection": "第二阶段 找到句子的核心",
      "sourceKind": "manual",
      "exampleOrigin": "manual"
    },
    {
      "id": 100002,
      "word": "he",
      "meaning": "他",
      "pos": "pron. 主格",
      "category": "人称代词",
      "usage": "作主语时用 he；一般现在时中常与动词第三人称单数形式搭配，be 用 is。",
      "examples": [
        {
          "sentence": "He reads a book.",
          "translation": "他读一本书。",
          "exampleOrigin": "manual"
